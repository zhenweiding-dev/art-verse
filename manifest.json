{
  "manifest_version": 3,
  "name": "Art & Verse",
  "version": "0.2.0",
  "description": "Public-domain paintings, your most visited sites, and a random classical Chinese text from Wikisource in every new tab.",
  "minimum_chrome_version": "106",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "topSites",
    "storage",
    "favicon",
    "downloads"
  ]
}
